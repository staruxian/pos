TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-database-token

# Вход по паролю НЕОБЯЗАТЕЛЕН и включается заданием обеих переменных ниже.
# Пока они пусты, касса работает без пароля, а API открыт всем, у кого есть адрес.
# Заполнять нужно обе сразу: одна без другой — это ошибка настройки, и API закроется.
#
# Пароль кассы, его вводят при входе:
# POS_PASSWORD=change-me
# Ключ подписи сессий, не короче 32 символов (openssl rand -base64 48).
# При смене ключа все открытые сессии завершаются.
# SESSION_SECRET=change-me-to-a-long-random-string

# Локальный мост печати этикеток (Xprinter). По умолчанию http://localhost:5000/print
# Если меняете адрес, обновите connect-src в Content-Security-Policy в vercel.json.
VITE_PRINT_URL=http://localhost:5000/print
