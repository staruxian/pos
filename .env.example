TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-database-token

# Пароль магазина в переменных окружения НЕ задаётся — он лежит в базе.
# Задать или сменить:
#
#   echo 'новый-пароль' | bun run set-password
#
# Пока пароль не задан, касса работает без входа и API открыт всем, у кого есть адрес.
# Ключ подписи сессий создаётся сам при первом входе и тоже хранится в базе.

# Локальный мост печати этикеток (Xprinter). По умолчанию http://localhost:5000/print
# Если меняете адрес, обновите connect-src в Content-Security-Policy в vercel.json.
VITE_PRINT_URL=http://localhost:5000/print
